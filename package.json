{
  "name": "@govnotech/conventions",
  "version": "0.1.1",
  "description": "Shared code-style conventions for TypeScript projects.",
  "keywords": [
    "code-style",
    "conventions",
    "eslint",
    "formatter",
    "linter",
    "oxfmt",
    "oxlint",
    "typescript"
  ],
  "homepage": "https://github.com/govnotech/conventions#readme",
  "license": "MIT",
  "author": "Vova Revenko <vova@revenko.org>",
  "repository": "github:govnotech/conventions",
  "files": [
    "dist"
  ],
  "type": "module",
  "typesVersions": {
    "*": {
      "oxfmt": [
        "./dist/oxfmt.d.mts"
      ],
      "oxlint": [
        "./dist/oxlint.d.mts"
      ],
      "eslint": [
        "./dist/eslint.d.mts"
      ]
    }
  },
  "exports": {
    "./oxfmt": {
      "types": "./dist/oxfmt.d.mts",
      "default": "./dist/oxfmt.mjs"
    },
    "./oxlint": {
      "types": "./dist/oxlint.d.mts",
      "default": "./dist/oxlint.mjs"
    },
    "./eslint": {
      "types": "./dist/eslint.d.mts",
      "default": "./dist/eslint.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepack": "pnpm build",
    "release:check": "pnpm check && pnpm build && npm pack --dry-run",
    "lint:ox": "oxlint --max-warnings 0",
    "lint:es": "eslint --max-warnings 0 --cache",
    "check": "run-p --continue-on-error check:*",
    "check:code": "run-p --continue-on-error lint:*",
    "check:format": "oxfmt --check",
    "check:spelling": "cspell lint",
    "check:spelling-unused": "cspell-check-unused-words",
    "check:types": "tsc --noEmit",
    "fix": "run-s fix:*",
    "fix:code": "run-s \"lint:ox --fix\" \"lint:es --fix\"",
    "fix:format": "oxfmt --write",
    "fix:spelling-unused": "cspell-check-unused-words --fix"
  },
  "dependencies": {
    "@darraghor/eslint-plugin-nestjs-typed": "^7.3.3",
    "@eslint/js": "^10.0.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "class-validator": "^0.15.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-drizzle": "^0.2.3",
    "eslint-plugin-jsdoc": "^64.2.1",
    "eslint-plugin-oxlint": "^1.79.0",
    "eslint-plugin-pinia": "^0.4.2",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-regexp": "^3.2.0",
    "eslint-plugin-rxjs-x": "^1.0.4",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "typescript-eslint": "^8.67.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "cspell": "^10.0.1",
    "cspell-check-unused-words": "^1.6.3",
    "eslint": "^10.8.1",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0",
    "oxfmt": ">=0.64.0 <1.0.0",
    "oxlint": ">=1.79.0 <2.0.0",
    "typescript": ">=5.5.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "oxfmt": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.28.2"
}
